{
  "name": "illogan-app-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Official website for Learning Numbers Kids Games (illogan.app)",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "node scripts/serve.mjs",
    "assets": "node scripts/make-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.5",
    "@fontsource-variable/fredoka": "^5.2.5",
    "@phosphor-icons/react": "^2.1.7",
    "motion": "^12.15.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "sharp": "^0.34.2",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
